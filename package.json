{
  "name": "focus",
  "version": "1.2.0",
  "description": "Block distracting websites and protect your settings with a passcode.",
  "author": "unknwoo",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun test --runInBand",
    "test": "TZ=UTC jest",
    "__rmrf-dist": "rimraf dist",
    "__no-emit": "tsc --noEmit",
    "__build-chrome": "TARGET=chrome tsup",
    "__build-firefox": "TARGET=firefox tsup",
    "build": "npm-run-all __rmrf-dist __no-emit __build-chrome __build-firefox"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/chrome": "^0.0.266",
    "@types/firefox-webext-browser": "^120.0.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2"
  },
  "dependencies": {
    "dayjs": "^1.11.10"
  }
}
