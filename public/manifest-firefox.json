{
  "manifest_version": 3,
  "name": "Focus",
  "description": "Block distracting websites, hide YouTube distractions, and protect settings with a passcode.",
  "version": "1.1.0",
  "icons": {
    "32": "icon_32.png",
    "128": "icon_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon_32.png",
      "128": "icon_128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus"
  ],
  "background": {
    "scripts": ["background.mjs"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "css": ["youtube-distractions.css"],
      "js": ["youtube-distractions.mjs"],
      "run_at": "document_start"
    }
  ],
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "{05FA41BD-D1D7-4A02-BCFF-F313267B8294}"
    }
  }
}
